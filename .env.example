# =============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file with secrets to git

# =============================================================================
# ENVIRONMENT MODE
# =============================================================================
# Set to "local" for development or "production" for deployed environment
NODE_ENV=local

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================
VITE_PUBLIC_SUPABASE_URL=your_supabase_url_here
VITE_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# =============================================================================
# STRIPE CONFIGURATION
# =============================================================================
# TEST MODE keys (use for development)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# LIVE MODE keys (uncomment for production - KEEP SECURE!)
# STRIPE_SECRET_KEY=sk_live_your_live_stripe_secret_key_here
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_live_stripe_publishable_key_here

# =============================================================================
# GOOGLE CLOUD SERVICES
# =============================================================================
# Google Maps API Key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud Vision (OCR) - Service Account JSON
# For local: use GOOGLE_APPLICATION_CREDENTIALS pointing to JSON file
# For Vercel: use GOOGLE_APPLICATION_CREDENTIALS_JSON with full JSON string
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# =============================================================================
# THIRD PARTY APIs
# =============================================================================
WALK_SCORE_API_KEY=your_walkscore_api_key_here

# =============================================================================
# APPLICATION URLS (Environment-specific)
# =============================================================================
# Backend server port (local only)
PORT=4000

# LOCAL MODE - Use these for development
VITE_APP_URL=http://localhost:5173
GEMINI_API_URL=http://localhost:4000/api/gemini/refine

# PRODUCTION MODE - Uncomment these for production deployment
# VITE_APP_URL=https://www.sub-space.me
# GEMINI_API_URL=https://www.sub-space.me/api/gemini/refine
# VITE_API_URL=https://www.sub-space.me/api
